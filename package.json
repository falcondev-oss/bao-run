{
  "name": "@falcondev-oss/bao-run",
  "version": "0.1.0",
  "description": "Run a command with secrets from OpenBao, like `infisical run`: AppRole login, one KV v2 secret as environment, no dependencies",
  "keywords": [
    "approle",
    "cli",
    "docker",
    "openbao",
    "secrets",
    "vault"
  ],
  "bugs": {
    "url": "https://github.com/falcondev-oss/bao-run/issues"
  },
  "license": "Apache-2.0",
  "repository": "github:falcondev-oss/bao-run",
  "bin": {
    "bao-run": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --type-aware . && oxfmt . --check",
    "lint:ci": "oxlint --type-aware --deny-warnings . && oxfmt . --check",
    "lint:fix": "oxlint --type-aware --fix . && oxfmt . --write",
    "type-check": "tsrs --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsdown": "0.23.4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "changelogithub": {
    "extends": "gh:falcondev-it/configs/changelogithub"
  }
}
